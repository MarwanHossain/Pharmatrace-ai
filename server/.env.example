# PharmaTrace AI — Backend Environment Configuration Example
# Copy this file to .env and set your local environment values.
# NEVER commit real credentials or secrets to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated for dev)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Application Runtime Account (Least Privilege: SELECT, INSERT, UPDATE, DELETE, EXECUTE)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharmatrace_ai
DB_USER=pharmatrace_app
DB_PASSWORD=your_secure_app_password_here
DB_CHARSET=utf8mb4

# Migration Account (DDL & Schema Management: CREATE, ALTER, DROP, INDEX, REFERENCES, etc.)
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=3306
MIGRATION_DB_NAME=pharmatrace_ai
MIGRATION_DB_USER=pharmatrace_migrator
MIGRATION_DB_PASSWORD=your_secure_migrator_password_here

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000

# Development-Only Security Controls (STRICTLY NON-PRODUCTION)
# When set to true in non-production environments (development/test), bypasses IP-based login throttling
# and account-level failed-login lockouts to facilitate rapid UI/API testing and login/logout workflows.
# STRICTLY IGNORED when NODE_ENV=production.
# DEV_AUTH_LOCKOUT_BYPASS=false
