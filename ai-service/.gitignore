# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment and secrets
.env
.env.*
!.env.example

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Dataset files (preserve directory tracking via .gitkeep)
data/generated/*
!data/generated/.gitkeep
data/processed/*
!data/processed/.gitkeep

# IDE and OS artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Note on Model Artifacts:
# The versioning and storage strategy for artifacts/ (local Git LFS vs. external cloud registry)
# will be decided and managed by the AI/ML developer.
