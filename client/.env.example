# PharmaTrace AI — Client Environment Configuration Example
# Set to relative path for same-origin or proxied API requests in development.
VITE_API_BASE_URL=/api

# Optional: Public application URL (default: http://localhost:5173 in development)
VITE_PUBLIC_APP_URL=http://localhost:5173

# Optional: Custom backend proxy target for Vite dev server (default: http://localhost:5000)
VITE_BACKEND_TARGET=http://localhost:5000
